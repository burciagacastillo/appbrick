{
  "name": "appbrick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "vercel-build": "prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "db:local": "prisma dev --name appbrick --detach",
    "db:migrar": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "rescan": "tsx scripts/operacion/rescanear.ts",
    "usuario": "tsx scripts/operacion/crear-usuario.ts",
    "llave": "tsx scripts/operacion/generar-llave.ts",
    "estado": "tsx scripts/diagnostico/ver-estado.ts",
    "prod:verificar": "node scripts/operacion/en-produccion.mjs tsx scripts/operacion/verificar-produccion.ts",
    "prod:migrar": "node scripts/operacion/en-produccion.mjs prisma migrate deploy",
    "prod:sembrar": "node scripts/operacion/en-produccion.mjs tsx prisma/seed.ts",
    "prod:usuario": "node scripts/operacion/en-produccion.mjs tsx scripts/operacion/crear-usuario.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "^2.117.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
