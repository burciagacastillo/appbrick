// AppBrick — Modelo de datos
// Grupo Brick, Chihuahua.
//
// La app tiene TRES caras y el modelo debe mantenerlas separadas:
//   1. Pública    — catálogo de casas en venta y vendidas. Sin login.
//   2. Privada    — admin (todo) y ayudante (solo documentos asignados).
//   3. Invitado   — comprador o vendedor entra por link y sube SUS documentos.
//
// Regla que no se rompe: los campos confidenciales (costos, márgenes, datos
// personales) NUNCA se serializan hacia la cara pública. La lista blanca vive
// en src/lib/publico.ts y es el único camino permitido hacia afuera.
//
// Nota sobre SQLite: no soporta enums nativos. Los valores válidos viven en
// src/lib/constants.ts como uniones de TypeScript. Al migrar a Postgres
// (Supabase) se pueden convertir a enums reales sin tocar la app.

generator client {
  provider = "prisma-client-js"
}

// La URL de conexión ya no vive aquí (Prisma 7): se define en prisma.config.ts.
datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Acceso: quién entra y hasta dónde
// ---------------------------------------------------------------------------

/// Usuario con cuenta. Solo dos tipos: admin (Erick) y ayudante.
/// El comprador/vendedor NO es usuario: entra por Invitacion, sin cuenta.
model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  /// "admin" | "ayudante"
  rol          String   @default("ayudante")
  passwordHash String?
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  // --- Segundo factor (app autenticadora) ---
  /// CIFRADO igual que las contraseñas de Infonavit: quien tenga este
  /// secreto genera códigos válidos, así que es tan sensible como la
  /// contraseña misma.
  totpSecretoCifrado String?
  /// Solo se activa cuando el usuario comprobó que su app genera códigos
  /// válidos. Un secreto guardado pero no confirmado no protege nada.
  totpActivo         Boolean @default(false)
  /// Último paso de 30 s usado: cada código sirve una sola vez.
  totpUltimoPaso     Int?

  /// El ayudante solo ve las propiedades que se le asignan aquí.
  /// El admin no necesita filas: ve todo por definición.
  accesos AccesoAyudante[]

  tramitesActualizados Tramite[]   @relation("TramiteActualizadoPor")
  gastosRegistrados    Gasto[]     @relation("GastoRegistradoPor")
  documentosSubidos    Documento[] @relation("DocumentoSubidoPorUsuario")
}

/// Alcance de un ayudante: "puedes ver los documentos de esta propiedad".
/// Nunca da acceso a dinero ni a datos personales sensibles.
model AccesoAyudante {
  id          String   @id @default(cuid())
  usuarioId   String
  propiedadId String
  creadoEn    DateTime @default(now())
  /// Acceso temporal. Null = sin vencimiento.
  expiraEn    DateTime?

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, propiedadId])
}

/// El link que le mandas por WhatsApp al comprador o al vendedor.
/// Entra sin cuenta, sube solo lo que le toca, y no ve nada más.
model Invitacion {
  id          String @id @default(cuid())
  /// Lo secreto del link. Largo y aleatorio: es la única credencial.
  token       String @unique
  propiedadId String
  personaId   String
  /// "comprador" | "vendedor" — define qué bloque del checklist ve.
  rol         String

  /// Bloques del catálogo que puede ver, separados por coma ("B" o "A").
  /// Se calcula del rol al crear la invitación, pero se puede ajustar.
  bloquesPermitidos String

  creadaEn     DateTime  @default(now())
  expiraEn     DateTime?
  revocada     Boolean   @default(false)
  ultimoAcceso DateTime?
  vecesUsada   Int       @default(0)

  /// LFPDPPP: hay que poder probar que aceptó el aviso de privacidad.
  avisoAceptadoEn DateTime?

  propiedad   Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  persona     Persona     @relation(fields: [personaId], references: [id], onDelete: Cascade)
  documentos  Documento[] @relation("DocumentoSubidoPorInvitacion")

  @@index([propiedadId])
}

/// Freno de fuerza bruta. Vive en la base y no en memoria porque en la nube
/// cada petición puede caer en un servidor distinto: en memoria, cada uno
/// llevaría su propia cuenta y el límite real se multiplicaría.
model IntentoAcceso {
  /// "login:correo@x.com" o "2fa:<usuarioId>"
  clave          String    @id
  intentos       Int       @default(0)
  bloqueadoHasta DateTime?
  actualizadoEn  DateTime  @updatedAt
}

/// Quién hizo qué y cuándo. Con datos personales de terceros esto no es
/// un lujo: es lo que te respalda si alguien reclama.
model Bitacora {
  id      String   @id @default(cuid())
  cuando  DateTime @default(now())
  /// "admin" | "ayudante" | "invitado" | "sistema"
  tipoActor String
  /// Nombre legible de quien actuó.
  actor     String
  /// "subio" | "aprobo" | "rechazo" | "descargo" | "revelo_password" | "creo_invitacion" | "revoco_invitacion" | "vio_expediente"
  accion    String
  /// Sobre qué objeto: "documento" | "tramite" | "persona" | "propiedad" | "invitacion"
  entidad   String
  entidadId String?
  detalle   String?

  @@index([cuando])
  @@index([entidad, entidadId])
}

// ---------------------------------------------------------------------------
// Personas: vendedores, compradores, socios, contratistas
// ---------------------------------------------------------------------------

model Persona {
  id       String  @id @default(cuid())
  nombre   String
  telefono String?
  email    String?
  curp     String?
  rfc      String?
  /// Número de seguro social. Es identificador, se guarda en claro.
  nss      String?

  // --- Datos que definen si el trámite procede ---
  /// "soltero" | "casado" | "union_libre" | "divorciado" | "viudo"
  estadoCivil String?
  /// "bienes_mancomunados" | "separacion_de_bienes" — define si firma el cónyuge.
  regimenMatrimonial String?
  conyugeNombre      String?
  domicilio          String?

  // --- Lo que sostiene la precalificación del comprador ---
  empleador        String?
  puesto           String?
  antiguedadMeses  Int?
  ingresoMensual   Float?

  // --- Crédito Infonavit ---
  numeroCredito String?
  /// Usuario del portal Infonavit (no es secreto).
  infonavitUsuario String?
  /// CIFRADA con AES-256-GCM (ver src/lib/cripto.ts). Solo admin la revela y
  /// cada revelación queda en Bitacora. NUNCA se manda a la cara pública ni
  /// al rol ayudante.
  infonavitPasswordCifrada String?

  notas String?

  referencias     Referencia[]
  participaciones PropiedadPersona[]
  invitaciones    Invitacion[]
  gastosPagados   Gasto[]            @relation("GastoPagadoPor")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombre])
}

/// Las dos referencias que pide la solicitud de crédito.
model Referencia {
  id         String  @id @default(cuid())
  personaId  String
  /// 1 o 2, el orden en la solicitud.
  orden      Int
  nombre     String
  telefono   String?
  parentesco String?

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, orden])
}

model PropiedadPersona {
  id          String @id @default(cuid())
  propiedadId String
  personaId   String
  /// "vendedor" | "comprador" | "socio" | "contratista" | "notario" | "valuador" | "otro"
  rol         String
  /// Solo para socios: % de participación en el proyecto.
  porcentaje  Float?
  notas       String?

  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  persona   Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, personaId, rol])
  @@index([propiedadId])
}

// ---------------------------------------------------------------------------
// Propiedades
// ---------------------------------------------------------------------------

model Propiedad {
  id        String  @id @default(cuid())
  nombre    String
  direccion String?
  colonia   String?
  ciudad    String  @default("Chihuahua")

  /// "prospecto" | "adquisicion" | "remodelacion" | "en_venta" | "en_tramite" | "escriturando" | "concluida" | "cancelada"
  etapa String @default("prospecto")
  /// "casa" | "terreno" | "departamento" | "local"
  tipo  String @default("casa")

  carpetaLocal String?
  carpetaDrive String?

  // === CONFIDENCIAL — nunca sale a la cara pública ========================
  valorCompra        Float?
  valorVentaEstimado Float?
  valorVentaReal     Float?
  presupuestoObra    Float?

  /// Lo que el vendedor debe a Infonavit y hay que liberar para poder vender.
  saldoCreditoVendedor Float?
  /// Crédito autorizado al comprador y lo que pone de su bolsa.
  montoCreditoComprador Float?
  enganche              Float?

  notaria              String?
  fechaFirmaProgramada DateTime?

  fechaCompra         DateTime?
  fechaVenta          DateTime?
  fechaCierreObjetivo DateTime?

  notas String?
  // =========================================================================

  // === PÚBLICO — esto sí se muestra en el catálogo abierto =================
  /// Interruptor maestro. Si es false, la propiedad no existe para el público.
  publicada Boolean @default(false)
  /// Aparece arriba en el catálogo.
  destacada Boolean @default(false)
  /// URL amigable: /casas/praderas-del-sur-1
  slugPublico String? @unique

  tituloPublico      String?
  descripcionPublica String?
  /// Precio de lista. En una casa vendida, el precio al que se vendió.
  precioPublico      Float?
  /// En vendidas, si se muestra el precio o solo el letrero de "Vendida".
  mostrarPrecio      Boolean @default(true)

  recamaras        Int?
  banos            Float?
  m2Terreno        Float?
  m2Construccion   Float?
  cochera          Int?
  aceptaInfonavit  Boolean @default(true)
  aceptaBancario   Boolean @default(true)
  // =========================================================================

  fotos       Foto[]
  tramites    Tramite[]
  documentos  Documento[]
  gastos      Gasto[]
  presupuesto PartidaPresupuesto[]
  personas    PropiedadPersona[]
  invitaciones Invitacion[]
  accesos     AccesoAyudante[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([etapa])
  @@index([publicada])
}

/// Fotos del catálogo público. Viven en el almacén de archivos igual que los
/// documentos, pero son lo único que se sirve sin autenticación.
model Foto {
  id          String  @id @default(cuid())
  propiedadId String
  /// Ruta relativa dentro del almacén.
  archivo     String
  /// Texto alternativo, para accesibilidad y buscadores.
  alt         String?
  /// SHA-256 del contenido: evita subir dos veces la misma foto del carrete.
  hash        String?
  orden       Int     @default(0)
  esPortada   Boolean @default(false)

  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@index([propiedadId, orden])
}

// ---------------------------------------------------------------------------
// Expediente: catálogo de 34 trámites + estado por propiedad + archivos
// ---------------------------------------------------------------------------

model TramiteCatalogo {
  id           String @id @default(cuid())
  /// 1..34 — la numeración con la que ya nombras los archivos.
  numero       Int    @unique
  /// "A".."H"
  bloque       String
  bloqueNombre String
  nombre       String

  /// Ciclo a=documento / b=orden de cobro / c=comprobante (municipales 20-24).
  requierePago Boolean @default(false)
  /// Solo aplica en ciertos casos (ej. acta de matrimonio).
  opcional     Boolean @default(false)

  /// No es un archivo: es un dato que se captura a mano (NSS, referencias).
  /// La UI muestra campos en vez de un botón de subir.
  esDato Boolean @default(false)

  /// Lo puede subir el invitado desde su link. Bloques A (vendedor) y B
  /// (comprador). Los municipales los tramitas tú, no él.
  loSubeInvitado Boolean @default(false)

  /// Días que el documento sigue siendo válido para el trámite. Los recibos
  /// caducan; una escritura no. Null = no caduca.
  vigenciaDias Int?

  dondeSeTramita String?
  notasAyuda     String?
  /// Instrucción en lenguaje llano para el comprador, que no sabe de trámites.
  ayudaInvitado  String?

  tramites Tramite[]

  @@index([bloque])
}

model Tramite {
  id          String @id @default(cuid())
  propiedadId String
  catalogoId  String

  /// "falta" | "revisar" | "completo" | "no_aplica"
  estado String @default("falta")

  docRecibido    Boolean @default(false)
  ordenDeCobro   Boolean @default(false)
  pagoComprobado Boolean @default(false)

  costo Float?

  /// Nombre del archivo en la carpeta de Windows. Se conserva para que el
  /// escáner de carpetas siga funcionando con lo que ya tenías antes de
  /// que la app guardara archivos.
  archivo    String?
  archivoUrl String?

  responsable String?
  fechaLimite DateTime?
  fechaHecho  DateTime?

  notas String?

  documentos       Documento[]
  propiedad        Propiedad       @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  catalogo         TramiteCatalogo @relation(fields: [catalogoId], references: [id])
  actualizadoPor   Usuario?        @relation("TramiteActualizadoPor", fields: [actualizadoPorId], references: [id])
  actualizadoPorId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([propiedadId, catalogoId])
  @@index([propiedadId, estado])
  @@index([fechaLimite])
}

/// Un archivo real guardado por la app. Un trámite puede tener varios:
/// el documento, la orden de cobro, el comprobante, y las versiones que
/// se rechazaron y se volvieron a subir.
model Documento {
  id          String  @id @default(cuid())
  propiedadId String
  tramiteId   String?
  /// "a" | "b" | "c" | null — cuál pieza del ciclo de pago es.
  subTipo     String?

  /// Como lo mandó quien lo subió (para no perder el rastro).
  nombreOriginal String
  /// Como lo guarda la app, con TU convención: "21a - Constancia ....pdf"
  nombreArchivo  String
  /// Ruta relativa dentro del almacén. Nunca una ruta absoluta.
  ruta           String
  mimeType       String
  tamanoBytes    Int
  /// SHA-256, para detectar que subieron dos veces el mismo archivo.
  hash           String?

  /// "pendiente" | "aprobado" | "rechazado"
  /// Lo que sube el invitado entra como "pendiente" hasta que tú lo revises.
  estado        String  @default("pendiente")
  motivoRechazo String?

  /// Fecha que dice el documento (no la de subida). Con esta se calcula
  /// la vigencia de recibos.
  fechaDocumento DateTime?
  /// Calculada al subir a partir de fechaDocumento + catalogo.vigenciaDias.
  vigenciaHasta  DateTime?

  /// "admin" | "ayudante" | "invitado"
  subidoPorTipo String
  subidoPorUsuario     Usuario?    @relation("DocumentoSubidoPorUsuario", fields: [subidoPorUsuarioId], references: [id])
  subidoPorUsuarioId   String?
  subidoPorInvitacion  Invitacion? @relation("DocumentoSubidoPorInvitacion", fields: [subidoPorInvitacionId], references: [id])
  subidoPorInvitacionId String?

  revisadoEn DateTime?

  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tramite   Tramite?  @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@index([propiedadId])
  @@index([tramiteId])
  @@index([estado])
  @@index([vigenciaHasta])
}

// ---------------------------------------------------------------------------
// Dinero — CONFIDENCIAL, nunca sale a la cara pública
// ---------------------------------------------------------------------------

model Gasto {
  id          String   @id @default(cuid())
  propiedadId String
  fecha       DateTime
  descripcion String
  categoria   String
  /// "efectivo" | "transferencia" | "tdc" | "tdd" | "cheque"
  metodo      String
  monto       Float

  pagadoPor   Persona? @relation("GastoPagadoPor", fields: [pagadoPorId], references: [id])
  pagadoPorId String?

  comprobante    String?
  comprobanteUrl String?

  notas String?

  propiedad       Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  registradoPor   Usuario?  @relation("GastoRegistradoPor", fields: [registradoPorId], references: [id])
  registradoPorId String?

  creadoEn DateTime @default(now())

  @@index([propiedadId, fecha])
  @@index([categoria])
}

model PartidaPresupuesto {
  id          String  @id @default(cuid())
  propiedadId String
  categoria   String
  monto       Float
  notas       String?

  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, categoria])
}
